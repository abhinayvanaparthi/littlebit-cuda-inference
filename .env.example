# Environment Configuration for LittleBit & INT2 Qwen3-8B Inference

# Target CUDA device ordinal
CUDA_DEVICE=cuda:0

# NVIDIA GPU Architecture target (sm_86 for RTX 3050 Ti / Ampere)
TORCH_CUDA_ARCH_LIST=8.6

# Static KV Cache length (512 for benchmark CLI, 2048 for server)
MAX_CACHE_LEN=2048

# Server host and port
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Optional Visual Studio vcvarsall.bat path override (defaults to BuildTools / Community auto-detect)
# VS_VCVARSALL=C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Auxiliary\Build\vcvarsall.bat
